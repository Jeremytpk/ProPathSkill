# ProPath AI (Anthropic API). Without it, matching still works and AI features use built-in fallbacks.
ANTHROPIC_API_KEY=""
# Optional: override the model. Defaults to claude-opus-5-5.
# PROPATH_AI_MODEL="claude-opus-5-5"

# Firebase Admin service account, needed for plans, payments and the Project Manager. Use one of:
# - FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY (from the key file; best on Netlify, which limits variable size)
# - FIREBASE_SERVICE_ACCOUNT (the whole JSON key on one line)
# - GOOGLE_APPLICATION_CREDENTIALS (path to the key file, for local development)
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Admins are accounts whose document in the Firestore `users` collection has role = "admin" (set by hand).

# CinetPay (mobile money and cards). Without these, local development uses simulated payments.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
# Optional: ALL (default), MOBILE_MONEY, CREDIT_CARD or WALLET, comma-separated.
# CINETPAY_CHANNELS="ALL"

# Automatic tutor payouts through CinetPay transfers (optional; payouts can also be recorded by hand).
# CINETPAY_TRANSFER_PASSWORD=""
# Currency of your CinetPay transfer account. If it isn't USD, also set how many units equal 1 USD.
# CINETPAY_PAYOUT_CURRENCY="USD"
# CINETPAY_PAYOUT_USD_RATE=""

# Website address: where people come back after paying.
APP_URL="https://your-domain.example"
# Only if the API is hosted on a different address than the website:
# SERVER_URL (the API's address), CORS_ORIGINS (allowed websites) and, at build time, VITE_API_URL.

# Local development: run long AI requests through the background job flow used on Netlify.
# PROPATH_ASYNC_JOBS="true"

# Local development only: give every signed-in user a plan ("basic" or "pro").
# PROPATH_DEV_PLAN="pro"

# Server port (default 3000).
# PORT=3000
