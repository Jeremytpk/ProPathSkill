rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Active plan from the subscription record, which only the server writes after payment.
    function hasPlan(uid, plans) {
      let sub = get(/databases/$(database)/documents/users/$(uid)).data.get('subscription', {});
      return sub.get('expiresAtMs', 0) > request.time.toMillis() && sub.get('plan', 'free') in plans;
    }

    // User accounts (email or Google sign-in).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(['subscription']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']);
      allow delete: if false;

      // Progress is kept in the cloud only with a paid plan; free users keep it on their device.
      match /data/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasPlan(uid, ['basic', 'pro']);
      }
      // Project Manager is part of Pro.
      match /projects/{projectId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasPlan(uid, ['pro']);
      }
      // Purchases (e.g. course exams), granted by the server after payment.
      match /entitlements/{entitlementId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Payments are created and updated by the server only.
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Public configuration (prices), managed through the admin API.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Reports: Immutable sharing dossiers
    match /reports/{reportId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // 3. Partners: Publicly visible, manageable in admin simulation
    match /partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Programs: Educational and training initiatives
    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. Team Applications: Placements matching partners and users
    match /team_applications/{applicationId} {
      allow read, create, update, delete: if true;
    }

    // 6. User Clicks: Tracked for monetization metrics and partner reporting
    match /user_clicks/{clickId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // 7. AI Courses: Interactive courses powered by ProPathSkill AI
    match /ai_courses/{courseId} {
      allow read, create, update, delete: if true;
    }
  }
}
